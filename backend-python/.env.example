# HoistGuard 后端配置示例 —— 复制为 .env 后按需修改
# 应用名称
APP_NAME=HoistGuard
# JWT 签名密钥（演示用，生产环境务必更换为随机长字符串）
SECRET_KEY=hoistguard-demo-secret-key-change-me-2026
# JWT 算法
ALGORITHM=HS256
# access token 有效期（秒），默认 24 小时
ACCESS_TOKEN_EXPIRE_SECONDS=86400
# 允许跨域来源（逗号分隔）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# 静态资源目录（相对 app 包目录）
STATIC_DIR=static
